
scenario "Create a post"

POST /posts

body:
  title: Learning Scenario
  userId: 1

expect:
  status: 201
  body.title: Learning Scenario
  body.userId: 1

scenario "Unknown todo returns 404"

GET /todos/999999

expect:
  status: 404


npx tsx src/cli/main.ts test examples/posts.scenario --base-url https://jsonplaceholder.typicode.com
